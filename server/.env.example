# Secure Portal API — environment variables (all have sensible local defaults)

# Base URL of the Keycloak instance
KEYCLOAK_URL=http://localhost:8080

# Realm whose tokens this API accepts
KEYCLOAK_REALM=secure-portal

# Audience this API requires in access tokens (FR-12).
# Must match the "api-audience" protocol mapper in keycloak/realm-export.json.
OIDC_AUDIENCE=secure-portal-api

# SPA client id — logout tokens (FR-13) are addressed to this client
OIDC_WEB_CLIENT_ID=portal-web

# Access token lifespan in seconds (must match accessTokenLifespan in
# keycloak/realm-export.json) — sets how long revoked sids are remembered
ACCESS_TOKEN_LIFESPAN=300

# API port
PORT=4000
